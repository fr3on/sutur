{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sutur",
  "version": "0.1.0",
  "identifier": "ink.sutur.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      { "label": "main", "title": "Sutur", "url": "https://sutur.ink/app", "width": 1180, "height": 800, "minWidth": 900, "minHeight": 620, "resizable": true, "titleBarStyle": "Overlay", "hiddenTitle": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education"
  }
}
